{
  "name": "peis-project-management",
  "version": "1.0.0",
  "description": "PEIS 项目管理系统 - 企业本地部署，对标 Teambition",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test:smoke": "node scripts/smoke.mjs",
    "container:up": "docker compose --env-file .env.container up -d --build",
    "container:down": "docker compose --env-file .env.container down"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  }
}

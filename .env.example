# ===== PEIS 项目管理系统 环境变量（示例） =====
# 服务监听端口（企业本地部署默认 9280）
PORT=9280
# 监听地址（0.0.0.0 表示局域网内所有网卡可达）
HOST=0.0.0.0
# JWT 签名密钥（生产环境请修改）
JWT_SECRET=peis_secret_change_me_2026
# OA 单点登录对接开关
OA_ENABLED=true
# OA 单点登录回调校验密钥
OA_SECRET=oa_demo_secret
# 钉钉/致信推送开关
DINGTALK_ENABLED=true
ZIXIN_ENABLED=true

# ===== MySQL 数据库连接（生产服务器部署） =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=peis
DB_POOL_SIZE=10
